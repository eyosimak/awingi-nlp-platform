# ==========================================
# Awingi NLP Platform — Environment Variables
# ==========================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env

# Application Settings
APP_NAME="Awingi NLP Platform"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security (Generate a secure secret key for production: openssl rand -hex 32)
SECRET_KEY="insecure-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite for zero-config development:
DATABASE_URL="sqlite:///data/app.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/awingi_nlp"

# Ingestion & Export Paths
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
DEFAULT_LANGUAGE="awn"
DEFAULT_ORTHOGRAPHY="latin_official"
